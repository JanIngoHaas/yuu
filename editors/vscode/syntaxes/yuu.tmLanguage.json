{
  "scopeName": "source.yuu",
  "name": "Yuu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.yuu",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.yuu",
          "match": "\\b(end|if|else|while|match|case|default|return|break|defer)\\b"
        },
        {
          "name": "keyword.declaration.yuu",
          "match": "\\b(fn|let|mut|dec|def|extern|struct|enum|union)\\b"
        },
        {
          "name": "keyword.operator.word.yuu",
          "match": "\\b(new|as)\\b"
        },
        {
          "name": "constant.language.boolean.yuu",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.yuu",
          "match": "\\bnil\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.yuu",
          "match": "\\b(i8|u8|i64|u64|f32|f64|bool|nil)\\b"
        },
        {
          "name": "support.type.yuu",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.yuu",
          "match": "(?:==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.yuu",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.yuu",
          "match": "(?:\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.other.yuu",
          "match": "(?:->|::|=>|!|~|&|\\|)"
        },
        {
          "name": "punctuation.separator.yuu",
          "match": "[:,;]"
        },
        {
          "name": "keyword.control.terminator.yuu",
          "match": "(?<=\\s)\\.(?=\\s|$)"
        },
        {
          "name": "punctuation.accessor.dot.yuu",
          "match": "\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.yuu",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yuu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yuu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.yuu",
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)\\b"
        },
        {
          "name": "entity.name.function.yuu",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.yuu",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
